SMARTDENT_ENV=development
# Usadas só por `npm run dev` / `npm test` (scripts/dev.mjs). Vazio = procura .venv e ~/.venvs/smartdent.
SMARTDENT_PYTHON=
SMARTDENT_PORT=8000
# Banco DESCARTÁVEL para os testes PostgreSQL (cada teste cria e remove um schema).
SMARTDENT_TEST_DATABASE_URL=postgresql://smartdent@127.0.0.1:5432/smartdent_testes
# PostgreSQL/pgvector (definitivo; obrigatório em produção). Vazio = SQLite provisório de SMARTDENT_DB_PATH.
# Ex. com docker compose: postgresql://smartdent:<senha>@127.0.0.1:5432/smartdent
SMARTDENT_DATABASE_URL=postgresql://smartdent@127.0.0.1:5432/smartdent
SMARTDENT_DB_POOL_SIZE=10
# Senha usada apenas pelo docker-compose.yml para criar o banco local.
SMARTDENT_DB_PASSWORD=
SMARTDENT_DB_PATH=data/smartdent.sqlite3
# Embeddings locais: fastembed (padrão) ou off. O modelo precisa gerar 384 dimensões.
SMARTDENT_EMBEDDINGS=fastembed
SMARTDENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Pasta do modelo baixado (~220 MB); padrão: pasta temporária do sistema.
FASTEMBED_CACHE_PATH=
# Distância de cosseno máxima para um trecho contar como contexto (0 = idêntico, 2 = oposto).
SMARTDENT_RETRIEVAL_MAX_DISTANCE=0.7
# Gere um valor aleatório de pelo menos 32 caracteres; não reutilize em produção.
SMARTDENT_SESSION_SECRET=
# Só habilite após autorização de chamadas reais e configuração do provedor.
SMARTDENT_LLM_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vazio = automático (pgvector com PostgreSQL, pending com SQLite). Opções: pgvector, local_keyword, pending.
SMARTDENT_RETRIEVAL=
# Provedor para chat, resumo e classificação (groq ou gemini).
SMARTDENT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
